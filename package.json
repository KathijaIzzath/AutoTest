{
  "name": "autotest",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "test:qa": "node scripts/run-tests.cjs --env=qa",
    "test:staging": "node scripts/run-tests.cjs --env=staging",
    "test:blob": "node scripts/run-tests.cjs --env=qa -- --reporter=blob",
    "test:chromium": "node scripts/run-tests.cjs --env=qa -- --project=chromium",
    "test:chromium:staging": "node scripts/run-tests.cjs --env=staging -- --project=chromium",
    "test:smoke": "node scripts/run-tests.cjs --env=qa -- --project=chromium tests/01_Mainlogin_test.spec.ts tests/02_LandingDashboard_test.spec.ts",
    "test:ui": "node scripts/run-tests.cjs -- --ui",
    "typecheck": "npx tsc -p tsconfig.json --noEmit",
    "report": "npx playwright show-report",
    "report:merge:today": "node scripts/merge-today-report.js",
    "report:show:today": "node scripts/show-today-report.js",
    "cleanup": "node scripts/cleanup-old-artifacts.js",
    "email:test": "node scripts/send-mock-report.js",
    "report:daily": "node scripts/generate-daily-report.js",
    "db:check": "node scripts/check-env-db.cjs",
    "db:check:staging": "node scripts/check-env-db.cjs --env=staging"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.16.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.17.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/pg": "^8.16.0"
  }
}
